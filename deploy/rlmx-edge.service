[Unit]
Description=RLMX Edge Server
After=network.target

[Service]
Type=simple
User=rlmx
ExecStart=/opt/rlmx/rlmx serve --host 0.0.0.0 --port 3000
Environment=RLMX_MODEL_DIR=/opt/rlmx/models
Environment=RLMX_EDGE_MODEL=qwen2.5-0.5b-q4
Restart=on-failure
MemoryMax=2G

[Install]
WantedBy=multi-user.target
