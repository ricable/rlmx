{
  "name": "@aix/mcp-server",
  "version": "0.1.0",
  "description": "MCP JSON-RPC server for the @aix ecosystem",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "import": "./dist/index.js", "require": "./dist/index.cjs", "types": "./dist/index.d.ts" }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aix/agents": "0.1.0",
    "@aix/billing": "0.1.0",
    "@aix/core": "0.1.0",
    "@aix/federation": "0.1.0",
    "@aix/marketplace": "0.1.0",
    "@aix/mesh": "0.1.0",
    "@aix/plugin": "0.1.0",
    "@aix/rlm": "0.1.0",
    "@aix/shared": "0.1.0",
    "@aix/swarm": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "vitest": "^1.6.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  }
}
