{
  "name": "@aix/core",
  "version": "0.1.0",
  "description": "NAPI bridge to RLMX Rust kernel — platform-specific native bindings",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "optionalDependencies": {
    "@aix/core-darwin-arm64": "0.1.0",
    "@aix/core-darwin-x64": "0.1.0",
    "@aix/core-linux-x64-gnu": "0.1.0",
    "@aix/core-linux-arm64-gnu": "0.1.0",
    "@aix/core-win32-x64-msvc": "0.1.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "vitest": "^1.6.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  },
  "files": [
    "dist"
  ],
  "license": "MIT"
}
